---
import { site } from '../data/site';
---
<div id="loader" role="status" aria-label="Loading">
  <div class="loader__boot">
    <p class="loader__title" data-loader-out>{site.wordmark}</p>
    <p class="loader__subtitle" data-loader-out>INSERT COIN</p>
  </div>
  <div>
    <div class="loader__inner">
      <span class="loader__name" data-loader-out>{site.name.toUpperCase()}</span>
      <span class="loader__count" data-loader-out data-loader-count>000</span>
    </div>
    <div class="loader__bar" data-loader-bar></div>
  </div>
</div>
